    "smoke": "node src/smoke.js",
    "migrate-check": "node migration-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "openai": "^4.104.0",
    "p-queue": "^7.4.1",
    "sqlite-vec": "^0.1.9"
  }
}
