{
  "name": "capri-discord-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Capri (Cyberpunk: Edgerunners 2) — autonomous living Discord persona with full server takeover CRUD, confirmation-gated deletes, multimodal context reading, and hybrid persistent memory.",
  "type": "module",
  "scripts": {
    "start": "python python/bot.py",
    "start:node": "node --max-old-space-size=512 src/index.js",
