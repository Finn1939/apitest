# === DISCORD BOT CREDENTIALS ===
DISCORD_TOKEN=your_discord_bot_token

# === AI PROVIDER (Gemini recommended for native audio/video/image/PDF, or NVIDIA/OpenAI-compatible) ===
# Chat provider: "auto", "gemini", or "openai" (NVIDIA/OpenAI-compatible).
# Set "openai" to keep text chat on NVIDIA even when Gemini voice is configured.
AI_PROVIDER=auto

# Option A: Google Gemini (supports native multimodal audio, video, PDF, images + fast tool planning)
GEMINI_API_KEY=your_gemini_api_key
# Optional comma-separated pool for higher throughput:
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-4-hydrogen
# Python Discord voice: Gemini Live ASR -> selected chat provider -> Fish Audio TTS.
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=fdef76c9b2e741119d817754bd8b5dd0
GEMINI_ASR_MODEL=gemini-3.5-transcribe-live
FISH_TTS_MODEL=s2.1-pro-free
VOICE_VAD_THRESHOLD=110

# Option B: NVIDIA NIM / OpenRouter / OpenAI-compatible endpoint
NVIDIA_API_KEYS=
NVIDIA_API_KEY=
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# === COMMAND AUTHORITY & TAKEOVER ACCESS ===
# Comma-separated Discord user IDs with full natural-language takeover authority.
COMMAND_USER_IDS=
# Allow Discord server owners / Administrators to command Capri naturally as well.
ALLOW_GUILD_ADMINS=true
# "full" = COMMAND_USER_IDS can wield all of Capri's server permissions;
# "mirror_actor" = also require the requester to personally hold each Discord permission.
COMMAND_TRUST_LEVEL=full
ADMIN_USER_IDS=
BOT_PREFIX=t
DISCORD_ACTIONS_ENABLED=true

# === AUTONOMOUS MIND & LIVING PRESENCE ===
# "high" | "medium" | "low" — controls how actively Capri chimes in, reacts, and starts convos.
AUTONOMY_LEVEL=high
SPONTANEOUS_CHANCE=0.14
SPONTANEOUS_COOLDOWN_MINUTES=4
AUTONOMOUS_REACT_CHANCE=0.22
CONVO_ENGAGE_MINUTES=15
WELCOME_NEW_MEMBERS=true

# === SERVER SYNC & MEMORY ===
FULL_SERVER_SYNC=true
DB_PATH=memory.db
PERSONALITY_PATH=personality.txt
MEMORY_CONTEXT_TOKENS=48000
TIMEZONE=Asia/Manila
TIMEZONE_LABEL=PHT

# === AI JUDGMENT LAYER ===
ANALYSIS_ENABLED=true
ANALYSIS_MAX_PER_MIN=16
REACTION_FLUSH_MINUTES=2
GAME_WATCH_CHANCE=0.25
GAME_WATCH_COOLDOWN_MINUTES=30

# === GENERATION SETTINGS ===
REPLY_THINKING=false
REPLY_TEMPERATURE=0.85
REPLY_MAX_TOKENS=1200
VISION_TRANSPORT=base64

# Python only. When set, this one Discord account controls commands and file creation.
USERID=
