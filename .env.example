DISCORD_TOKEN=your_discord_bot_token
# Optional: comma-separated pool of NVIDIA keys for higher request limits.
# All keys hit the SAME model and endpoint. Falls back to NVIDIA_API_KEY.
NVIDIA_API_KEYS=key_one,key_two,key_three
NVIDIA_API_KEY=your_nvidia_api_key
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Embeddings run locally (all-MiniLM-L6-v2); no embedding API is used.
BOT_PERSONALITY=Friendly, witty, curious, and supportive. Speak naturally, like a real person. Keep answers concise unless more detail is helpful.
DB_PATH=memory.db
PERSONALITY_PATH=personality.txt
ADMIN_USER_IDS=
BOT_PREFIX=t
SPONTANEOUS_CHANCE=0.04
SPONTANEOUS_COOLDOWN_MINUTES=15
# After she replies to someone, their follow-up messages are guaranteed a reply
# (no mention/reply needed) for this many minutes while the conversation flows.
CONVO_ENGAGE_MINUTES=10
MEMORY_CONTEXT_TOKENS=32000
# Her clock runs on Philippine time by default. Any IANA zone name works.
TIMEZONE=Asia/Manila
TIMEZONE_LABEL=PHT
# AI judgment layer (all optional, defaults shown). ANALYSIS_ENABLED=false
# disables it entirely — reactions fall back to the flat heart rule.
ANALYSIS_ENABLED=true
# Judgment calls per minute, out of the shared key pool (10 of 120 RPM).
ANALYSIS_MAX_PER_MIN=10
# How long reactions queue before ONE batched interpretation call.
REACTION_FLUSH_MINUTES=2.5
# Spectator comments in game channels: chance a juicy panel is considered,
# and the per-channel quiet period after she comments.
GAME_WATCH_CHANCE=0.2
GAME_WATCH_COOLDOWN_MINUTES=45
