DISCORD_TOKEN=your_discord_bot_token
# Optional: comma-separated pool of NVIDIA keys for higher request limits.
# All keys hit the SAME model and endpoint. Falls back to NVIDIA_API_KEY.
NVIDIA_API_KEYS=key_one,key_two,key_three
NVIDIA_API_KEY=your_nvidia_api_key
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Embeddings run locally (all-MiniLM-L6-v2); no embedding API is used.
BOT_PERSONALITY=Friendly, witty, curious, and supportive. Speak naturally, like a real person. Keep answers concise unless more detail is helpful.
DB_PATH=memory.db
PERSONALITY_PATH=personality.txt
ADMIN_USER_IDS=
BOT_PREFIX=t
SPONTANEOUS_CHANCE=0.04
SPONTANEOUS_COOLDOWN_MINUTES=15
